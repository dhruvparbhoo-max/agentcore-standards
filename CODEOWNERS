# Lease map (DESIGN §8). One ownership path per line.
# @agentcore/platform is the standing platform owner. GitHub enforces these
# teams only after they exist in the org. Until then the coordinator still
# grants one writer per path. Do not put two agents on the same path.
#
# /pyproject.toml and /uv.lock are serialized to platform. A package lease
# does not include them unless the coordinator adds that lease explicitly.

/pyproject.toml                         @agentcore/platform
/uv.lock                                @agentcore/platform
/.github/                               @agentcore/platform
/scripts/                               @agentcore/platform

/packages/agentcore-tracing/            @agentcore/platform
/packages/agentcore-eval/               @agentcore/platform
/packages/agentcore-session/            @agentcore/platform
/packages/agentcore-tools/              @agentcore/platform
/packages/agentcore-memory/             @agentcore/platform
/packages/agentcore-guardrails/         @agentcore/platform

/templates/minimal-agent/               @agentcore/platform
/templates/agent-with-tools/            @agentcore/platform
/templates/agent-with-memory/           @agentcore/platform
/templates/multi-agent/                 @agentcore/platform
/templates/human-in-the-loop/           @agentcore/platform

/docs/                                  @agentcore/platform
/experiments/                           @agentcore/platform
