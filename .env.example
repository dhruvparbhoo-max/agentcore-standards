# Copy to .env for local runs. Never commit .env.
# Placeholder names only. Values stay in the environment or a secret store.
# Do not commit resource ARNs, account ids, access keys, or session tokens.

# Dev account region. Evals use this same account (DESIGN §7). Isolate with
# agent versions, namespaces, and IAM paths. Required for the runtime judge.
AWS_REGION=

# Optional credential pair. Set both, or set neither and use a role.
# A key without its secret is incomplete. A role needs neither name.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Supplied at deploy time when a judge runs the real Runtime path.
# Leave empty in git.
AGENTCORE_RUNTIME_ARN=

# Optional InvokeAgentRuntime qualifier (an endpoint name). A version label, not an ARN.
AGENTCORE_RUNTIME_QUALIFIER=

# CloudWatch log group name for span collection on the real Runtime path. Not an ARN.
# Required for the runtime judge.
AGENTCORE_SPAN_LOG_GROUP=

# Optional application-log group for agentcore.turn lines. Defaults to the span log group.
AGENTCORE_APP_LOG_GROUP=

# memory (default, in-process) or runtime (InvokeAgentRuntime).
AGENTCORE_EVAL_HARNESS=memory

# GitHub Actions OIDC role for the invoice-desk runtime job.
# Leave empty when the job should use access keys instead.
AWS_ROLE_TO_ASSUME=

# Optional hosted model id for ChatBedrockConverse. Not an ARN.
# Default in code: us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=

# Optional. When set, the LangGraph thread checkpointer is AgentCoreMemorySaver.
# Session events still go through agentcore-memory, which is not this id.
AGENTCORE_MEMORY_ID=

# Gateway sync for the invoice desk. Not required for the runtime judge
# to report SKIPPED. The Lambda must be agent_with_tools.billing.lambda_handler.
AGENTCORE_GATEWAY_ID=
AGENTCORE_POLICY_ENGINE_ID=
AGENTCORE_TOOLS_LAMBDA_ARN=
AGENTCORE_GATEWAY_RESOURCE=
